# ─────────────────────────────────────────────────
#  RETRIEVER BACKEND
#  Values: mock | qdrant
#  • mock   → in-memory cosine similarity (no deps, works today)
#  • qdrant → plug in when the other developer's Qdrant is ready
# ─────────────────────────────────────────────────
RETRIEVER=mock

# ─────────────────────────────────────────────────
#  OLLAMA  (local LLM)
# ─────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768         # nomic-embed-text = 768  |  mxbai-embed-large = 1024

# ─────────────────────────────────────────────────
#  QDRANT  (uncomment when ready)
# ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs
QDRANT_API_KEY=

# ─────────────────────────────────────────────────
#  PIPELINE TUNING
# ─────────────────────────────────────────────────
APP_PORT=8000
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
