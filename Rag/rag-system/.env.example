# ─────────────────────────────────────────────────
#  OLLAMA  (local LLM — must be running)
# ─────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768         # nomic-embed-text = 768  |  mxbai-embed-large = 1024

# ─────────────────────────────────────────────────
#  QDRANT  (must be reachable — there is no offline mode)
#  Local:  docker compose -f docker/docker-compose.yml up -d
# ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs        # company data — never used as policy authority
QDRANT_API_KEY=
QDRANT_TIMEOUT=60

# ─────────────────────────────────────────────────
#  POLICY GATE
# ─────────────────────────────────────────────────
JUDGE_MODEL=llama3.1:8b           # deliberately larger than LLM_MODEL
POLICY_COLLECTION=policy_docs     # rules only, separate from company data
POLICY_TOP_K=20                   # recall over precision — a missed rule allows
POLICY_FAIL_CLOSED=True           # judge error/timeout ⇒ DENY, never allow

# ─────────────────────────────────────────────────
#  BASELINE SPLITTER
#  Used only by scripts.verify_policy_chunking, to reproduce what a general
#  character-window splitter does to a policy clause. Not used by the gate.
# ─────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
