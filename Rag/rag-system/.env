# ─────────────────────────────────────────────────
#  RETRIEVER BACKEND
#  Values: mock | qdrant
#  • mock   → in-memory cosine similarity (no deps, works today)
#  • qdrant → plug in when the other developer's Qdrant is ready
# ─────────────────────────────────────────────────
RETRIEVER=qdrant

# ─────────────────────────────────────────────────
#  OLLAMA  (local LLM)
# ─────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768         # nomic-embed-text = 768  |  mxbai-embed-large = 1024

# ─────────────────────────────────────────────────
#  QDRANT  (uncomment when ready)
# ─────────────────────────────────────────────────
# QDRANT_URL=http://localhost:6333
QDRANT_URL=https://0efdbe0d-3d90-4966-8a51-5cdb31ea3e30.australia-southeast1-0.gcp.cloud.qdrant.io
QDRANT_COLLECTION=rag_docs

# ─────────────────────────────────────────────────
#  PIPELINE TUNING
# ─────────────────────────────────────────────────
APP_PORT=8000
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NGVjNTNmYjMtNWIwOC00MDc3LTgzYzAtMDE2NjBiZmQ4Mjk1In0.b-NcWwsifS5gsKQqerAxe8U4bateQm9PAfVVZqsOUqI